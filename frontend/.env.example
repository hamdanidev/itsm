# Leave empty for same-origin deployment behind Caddy.
# Only set this if the PocketBase API is intentionally on another origin.
VITE_API_BASE_URL=

# Panduan pengguna (dibangun oleh `npm run guide:publish`).
# Default /panduan.html; isi `off` untuk menyembunyikan tautan Bantuan.
VITE_GUIDE_URL=/panduan.html