# Bentuk instalasi: "standalone" (satu rumah sakit, default) atau "vendor"
# (satu instalasi mengelola banyak rumah sakit lewat Konsol Vendor).
# Mode hanya dibaca dari environment, tidak bisa diubah dari dalam aplikasi.
TENANCY_MODE=standalone

# Production edge
APP_DOMAIN=itsm.rs.example.com
ACME_EMAIL=it@rs.example.com

# Pinned PocketBase version. Do not use "latest".
PB_VERSION=0.40.5
# Optional: supply the SHA-256 of the linux-<arch> release zip in CI/build.
PB_SHA256=

# Named volume (never bind-mount pb_data)
PB_VOLUME_NAME=healthcare_itsm_pb_data
BACKUP_HOST_DIR=./backups

# Dev tanpa Docker (scripts/dev.mjs). Opsional; nilai di bawah adalah default.
# PB_HTTP=127.0.0.1:8090
# DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TZ=Asia/Jakarta
GOMEMLIMIT=512MiB

# Email transaksional (undangan akun + notifikasi tiket).
# Contoh Mailtrap: ambil host/port/username/password dari inbox Mailtrap
# (Sandbox > SMTP Settings). Port 2525/587 memakai STARTTLS, jadi biarkan
# SMTP_TLS=false; isi true hanya untuk TLS implisit (biasanya port 465).
# Kosongkan SMTP_HOST untuk memakai setelan SMTP di Admin UI PocketBase.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_AUTH_METHOD=PLAIN
SMTP_FROM=no-reply@itsm.local
SMTP_FROM_NAME=Healthcare ITSM

# Nama dan URL aplikasi yang dipakai di email.
APP_NAME=Healthcare ITSM
APP_URL=http://localhost:5173

# Optional, only if SMTP/S3 settings are stored in PocketBase:
# PB_ENCRYPTION_KEY=replace-with-32-random-characters
