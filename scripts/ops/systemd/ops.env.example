# Salin ke /etc/healthcare-itsm/ops.env lalu sesuaikan.
# chmod 600 file ini; OPS_PUSH_URL berisi token rahasia Uptime Kuma.
OPS_URL=https://itsm.rs.example.com
OPS_BACKUP_DIR=/srv/backups
OPS_DATA_DIR=/var/lib/docker/volumes/healthcare_itsm_pb_data/_data
OPS_PUSH_URL=https://uptime.example.com/api/push/GANTI_TOKEN
OPS_MAX_BACKUP_AGE_HOURS=26
OPS_DISK_WARN=80
OPS_DISK_CRITICAL=90
