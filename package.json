{
  "name": "healthcare-itsm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Healthcare ITSM - dev tooling tanpa Docker (PocketBase native + Vite)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:pb": "node scripts/dev.mjs --pb-only",
    "dev:web": "node scripts/dev.mjs --web-only",
    "pb:download": "node scripts/pocketbase.mjs download",
    "pb:serve": "node scripts/pocketbase.mjs serve",
    "pb:superuser": "node scripts/pocketbase.mjs superuser create",
    "pb:migrate": "node scripts/pocketbase.mjs migrate",
    "pb:setup-token": "node scripts/pocketbase.mjs setup-token",
    "pb:zoneinfo": "node scripts/zoneinfo.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:tiny": "node scripts/seed.mjs --profile tiny",
    "seed:small": "node scripts/seed.mjs --profile small",
    "seed:medium": "node scripts/seed.mjs --profile medium",
    "seed:busy": "node scripts/seed.mjs --profile busy",
    "seed:reset": "node scripts/seed.mjs --reset",
    "ops:check": "node scripts/ops/check.mjs",
    "ops:restore-drill": "node scripts/ops/restore-drill.mjs",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:api": "node tests/run-api.mjs",
    "test:e2e": "node --test --test-concurrency=2 \"tests/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
